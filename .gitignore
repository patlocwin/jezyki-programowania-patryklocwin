# Skompilowane pliki klas i archiwa
*.class
*.log
*.ctxt

# Archiwa (paczki wykonywalne / biblioteki)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Wyjątki: wrappery narzędzi budujących (jeśli używane)
!gradle/wrapper/gradle-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar

# Logi błędów i zrzuty maszyny wirtualnej (JVM)
hs_err_pid*
replay_pid*

# Katalogi wyjściowe budowania (Build outputs)
bin/
out/
build/
target/
dist/

# Narzędzia budujące: Gradle & Maven
.gradle/
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.properties

# Środowisko IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

